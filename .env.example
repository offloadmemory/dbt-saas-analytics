# Databricks Free Edition connection values. Copy this to `.env` and fill in
# the four values before running any poe task. `.env` is gitignored; this file
# is the per-repository template.
#
# Where to find each value:
#   DBT_DATABRICKS_HOST       Workspace browser URL, no scheme.
#                             e.g. dbc-74359442-7f30.cloud.databricks.com
#   DBT_DATABRICKS_HTTP_PATH  SQL Warehouse → Connection details → HTTP path.
#                             e.g. /sql/1.0/warehouses/06db33b91db8d701
#   DBT_DATABRICKS_TOKEN      User Settings → Developer → Access tokens.
#                             Looks like dapi...
#   DBT_DATABRICKS_CATALOG    Catalog Explorer → top-level catalog name.
#                             Free Edition creates one per workspace; this
#                             repo's workspace uses "dbt_sass_analytics".

DBT_DATABRICKS_HOST=
DBT_DATABRICKS_HTTP_PATH=
DBT_DATABRICKS_TOKEN=
DBT_DATABRICKS_CATALOG=
